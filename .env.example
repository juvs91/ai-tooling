# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in actual values
# DO NOT commit .env to git
# ============================================================

# Agent Skills Sync
AGENTS_REPO_DEFAULT=git@github.com:your-org/your-repo.git
AGENTS_REF_DEFAULT=master

# GitOps — set only if your authoritative remote isn't "origin"/"upstream"
GITOPS_REMOTE=your-remote-name
GITOPS_SCOPE=@your-org

# Tool Configuration
TOOL_ALLOWLIST=""
POLICY_NOTE_IN_SYSTEM=1
MAX_INPUT_TOKENS=30000
HARD_BLOCK_OVERSIZE=0

HOST_SERVER=./vendor/claude-code-proxy/server.py
CONTAINER_SERVER=/claude-code-proxy/server.py

# Web Search (Serper)
SERPER_API_KEY=YOUR_SERPER_API_KEY_HERE

# Atlassian Configuration
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_USERNAME=your.email@example.com
ATLASSIAN_CONFLUENCE_TOKEN=YOUR_CONFLUENCE_TOKEN_HERE
ATLASSIAN_JIRA_API_TOKEN=YOUR_JIRA_TOKEN_HERE
ATLASSIAN_BITBUCKET_API_TOKEN=YOUR_BITBUCKET_TOKEN_HERE
BITBUCKET_DEFAULT_WORKSPACE=your-workspace
# Fallback doc link shown by .claude/settings.json's "connections.atlassian" hint when the MCP connection fails
ATLASSIAN_DOCS_URL=https://your-domain.atlassian.net/wiki/YOUR-SPACE

# Database Configuration
ALLOYDB_PASSWORD=YOUR_DB_PASSWORD_HERE

# Squit Search MCP (Deacero-specific legacy SQL search — not a generic capability)
SQUIT_MCP_URL=https://squit-mcp.deacero.us/mcp
SQUIT_API_KEY=YOUR_SQUIT_API_KEY_HERE

# SonarQube (sonarqube-mgmt skill)
SONAR_HOST=https://sonar.your-domain.com
SONAR_TOKEN=<your-sonar-token>

# code-review skill — local checkout root + reviewer name (falls back to `git config user.name`)
CODE_REVIEW_WORKSPACE_ROOT=/Users/you/path/to/bitbucket-checkouts
CODE_REVIEW_REVIEWER_NAME=Your Name

"env": {
"ANTHROPIC_BASE_URL": "http://localhost:8083",
"ANTHROPIC_AUTH_TOKEN": "proxy-local",
"ANTHROPIC_MODEL": "claude-sonnet-4-6",
"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "243000",
"CLAUDE_AUTO_COMPACT_ENABLED": "true"
},
