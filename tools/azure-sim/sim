#!/usr/bin/env bash
# sim — simulador local de Azure Pipelines + ACR + Azure Artifacts (ADR-0061).
#
#   tools/azure-sim/sim up            levanta el stack (registry, nginx "ACR", azure-mock, pypi, agente)
#   tools/azure-sim/sim run [esc…]    corre escenarios (default: all) — ver azsim/scenarios.py
#   tools/azure-sim/sim status        servicios y salud
#   tools/azure-sim/sim down          baja el stack y borra el estado (registry, feed, .work)
#
# Requiere Docker Engine con compose y buildx (docker info debe responder).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SIM_WORK="${SIM_WORK:-$HERE/.work}"
export SIM_UID="$(id -u)" SIM_GID="$(id -g)"
export DOCKER_GID="$(stat -c %g /var/run/docker.sock 2>/dev/null || echo 999)"
COMPOSE=(docker compose -f "$HERE/docker-compose.yml")

die() { printf 'sim: %s\n' "$*" >&2; exit 1; }

require_docker() {
  docker info >/dev/null 2>&1 || die "docker no responde (¿Docker Engine instalado y corriendo? ver tools/azure-sim/README.md)"
  docker compose version >/dev/null 2>&1 || die "falta el plugin docker compose"
  docker buildx version >/dev/null 2>&1 || die "falta el plugin docker buildx"
}

wait_http() { # <url> <nombre>
  local i
  for i in $(seq 1 60); do
    curl -fsS -o /dev/null "$1" 2>/dev/null && return 0
    sleep 1
  done
  die "$2 no respondió en 60s ($1) — revisa: ${COMPOSE[*]} logs"
}

cmd_up() {
  require_docker
  mkdir -p "$SIM_WORK"
  "${COMPOSE[@]}" up -d --build
  wait_http http://localhost:5000/v2/ "ACR (nginx → registry)"
  wait_http http://localhost:8081/ "pypi"
  wait_http http://localhost:8082/_sim/health "azure-mock"
  echo "sim: stack arriba — ACR localhost:5000 · feed localhost:8081 · azure-mock localhost:8082"
}

cmd_down() {
  require_docker
  "${COMPOSE[@]}" down -v --remove-orphans
  rm -rf "$SIM_WORK"
  echo "sim: stack abajo y estado borrado"
}

cmd_status() {
  require_docker
  "${COMPOSE[@]}" ps
}

cmd_run() {
  require_docker
  [[ -n "$("${COMPOSE[@]}" ps -q agent)" ]] || die "el stack no está arriba — corre: $0 up"
  # Estado limpio por corrida: registry y feed nuevos, locks y llamadas en cero.
  # nginx (acr) también: resuelve las IPs de sus upstreams al arrancar y un
  # registry recreado cambia de IP → 502. --renew-anon-volumes: registry y pypi
  # guardan datos en volúmenes anónimos que --force-recreate conserva.
  "${COMPOSE[@]}" up -d --force-recreate --renew-anon-volumes --no-deps registry pypi azure-mock acr >/dev/null
  wait_http http://localhost:5000/v2/ "ACR"
  wait_http http://localhost:8081/ "pypi"
  wait_http http://localhost:8082/_sim/health "azure-mock"
  # Imagen base del fixture en cache local: un timeout de Docker Hub no es un fallo del pipeline
  docker pull -q busybox:1.36 >/dev/null || die "no se pudo bajar busybox:1.36 (¿red?)"
  cd "$HERE"
  python3 -m azsim.scenarios --work "$SIM_WORK/run" "$@"
}

case "${1:-}" in
  up)     cmd_up ;;
  down)   cmd_down ;;
  status) cmd_status ;;
  run)    shift; cmd_run "$@" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
