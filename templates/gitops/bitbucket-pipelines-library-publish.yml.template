# bitbucket-pipelines.yml — Template GitOps Monorepo Publicación de Librerías
# Ref: ADR-0007-gitops-monorepo-trunk-based.md
#
# CASO DE USO: Monorepo con librerías (Python / TypeScript / Go) publicadas
# a GCP Artifact Registry via Workload Identity Federation (OIDC).
#
# VARIABLES DE REPOSITORIO (Settings → Repository variables):
#   WIF_PROVIDER  — projects/PROJECT_NUM/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
#   GCP_DEPLOY_SA — sa-name@gcp-project.iam.gserviceaccount.com
#   GCP_PROJECT   — gcp-project-id
#   NPM_SCOPE     — scope de paquetes npm de tu organización, ej. @tu-empresa (sin el @ en la variable)
#
# CONVENCIÓN DE TAGS — <proyecto>@<version>, igual que `release.sh tag` (ADR-0007):
#   python-auth@1.2.3     → publica python/<nombre> con versión 1.2.3
#   typescript-auth@1.2.3 → publica typescript/<nombre> con versión 1.2.3
#   go-auth@1.2.3         → publica go/<nombre> con versión 1.2.3
# Renombra "auth" por el nombre real de cada librería (debe coincidir con el nombre de
# proyecto usado en GITOPS_PROJECT_MAP / `release.sh bump|tag <proyecto> ...`).
#
# VERSIONADO DEV (branches dev/main):
#   Versión base del pyproject.toml/package.json/VERSION + .dev.<BUILD_NUMBER>
#
# REQUISITOS:
#   - OIDC habilitado en cada step que publique (oidc: true)
#   - Makefile con targets: setup, lint, test, publish en cada paquete
#   - Para Go: archivo VERSION en go/<nombre>/
#   - Registries configurados en GCP Artifact Registry (PyPI, npm, Go module proxy)

definitions:
  scripts:
    # Autenticación WIF con GCP — reutilizable en todos los steps de publicación
    - &gcp-auth |
      echo "${BITBUCKET_STEP_OIDC_TOKEN}" > /tmp/bb_oidc_token
      gcloud iam workload-identity-pools create-cred-config "$WIF_PROVIDER" \
        --service-account="$GCP_DEPLOY_SA" \
        --credential-source-file=/tmp/bb_oidc_token \
        --credential-source-type=text \
        --output-file=/tmp/wif_cred.json
      gcloud auth login --cred-file=/tmp/wif_cred.json --quiet

    - &install-make "apt-get update --quiet && apt-get install -y make --quiet"

    # Guard: Bitbucket NO soporta clases de caracteres ([0-9]) en patrones de tag —
    # solo * y ** (verificado contra la doc oficial + foro de Atlassian, 2026-08-05).
    # Por eso el patrón 'python-auth@*' matchea TAMBIÉN los tags de bookkeeping que
    # crea `release.sh promote/hotfix` (-dev.N/-rc.N/-hotfix.N). No se puede filtrar
    # en el YAML — se valida en bash, como PRIMER paso de cada *-publish-tag, ANTES
    # de autenticar con GCP. exit 0 (no falla en rojo) porque no es un error: es un
    # tag de bookkeeping que legítimamente no debe publicar nada.
    - &reject-suffixed-tag |
      if echo "$BITBUCKET_TAG" | grep -qE -- '-(dev|rc|hotfix)\.[0-9]+$'; then
        echo "Tag $BITBUCKET_TAG tiene sufijo -dev/-rc/-hotfix — es bookkeeping de"
        echo "release.sh promote/hotfix, no un tag de publish. Saltando sin error."
        exit 0
      fi

    - &go-publish-setup |
        apk add --no-cache go make
        gcloud components install package-go-module --quiet
        cd go/auth
        go mod download

  steps:
    # ── python/<nombre> ───────────────────────────────────────────────────────
    - step: &python-test
        name: Test python/auth
        image: python:3.11-slim
        caches: [pip]
        condition:
          changesets:
            includePaths: ["python/auth/**", "bitbucket-pipelines.yml"]
        script:
          - *install-make
          - cd python/auth
          - make setup
          - make lint
          - make test

    - step: &python-publish-dev
        name: Publish python/auth (dev)
        image: google/cloud-sdk:slim
        oidc: true
        condition:
          changesets:
            includePaths: ["python/auth/**"]
        script:
          - *gcp-auth
          - apt-get install -y make python3 python3-pip --quiet
          - cd python/auth
          - make setup
          - CURRENT_VERSION=$(grep -m 1 "^version" pyproject.toml | cut -d'"' -f2)
          - sed -i "s/version = \"$CURRENT_VERSION\"/version = \"$CURRENT_VERSION.dev$BITBUCKET_BUILD_NUMBER\"/" pyproject.toml
          - make publish

    - step: &python-publish-tag
        name: Publish python/auth
        image: google/cloud-sdk:slim
        oidc: true
        script:
          - *reject-suffixed-tag
          - *gcp-auth
          - apt-get install -y make python3 python3-pip --quiet
          - cd python/auth
          - make setup
          - VERSION="${BITBUCKET_TAG#python-auth@}"
          - sed -i "s/^version = \".*\"/version = \"$VERSION\"/" pyproject.toml
          - make publish

    # ── typescript/<nombre> ───────────────────────────────────────────────────
    - step: &typescript-test
        name: Test typescript/auth
        image: node:20-slim
        condition:
          changesets:
            includePaths: ["typescript/auth/**", "bitbucket-pipelines.yml"]
        script:
          - *install-make
          - cd typescript/auth
          - make setup
          - make lint
          - make test

    - step: &typescript-publish-dev
        name: Publish typescript/auth (dev)
        image: google/cloud-sdk:slim
        oidc: true
        condition:
          changesets:
            includePaths: ["typescript/auth/**"]
        script:
          - *gcp-auth
          - curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt-get install -y make nodejs --quiet
          - TOKEN=$(gcloud auth print-access-token)
          - npm config set @${NPM_SCOPE}:registry https://us-central1-npm.pkg.dev/$GCP_PROJECT/dea-comm-npm/
          - npm config set "//us-central1-npm.pkg.dev/$GCP_PROJECT/dea-comm-npm/:_authToken" "$TOKEN"
          - cd typescript/auth
          - make setup
          - CURRENT_VERSION=$(node -p "require('./package.json').version")
          - npm version "${CURRENT_VERSION}-dev.${BITBUCKET_BUILD_NUMBER}" --no-git-tag-version
          - make publish

    - step: &typescript-publish-tag
        name: Publish typescript/auth
        image: google/cloud-sdk:slim
        oidc: true
        script:
          - *reject-suffixed-tag
          - *gcp-auth
          - curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt-get install -y make nodejs --quiet
          - TOKEN=$(gcloud auth print-access-token)
          - npm config set @${NPM_SCOPE}:registry https://us-central1-npm.pkg.dev/$GCP_PROJECT/dea-comm-npm/
          - npm config set "//us-central1-npm.pkg.dev/$GCP_PROJECT/dea-comm-npm/:_authToken" "$TOKEN"
          - cd typescript/auth
          - make setup
          - VERSION="${BITBUCKET_TAG#typescript-auth@}"
          - npm version "$VERSION" --no-git-tag-version
          - make publish

    # ── go/<nombre> ───────────────────────────────────────────────────────────
    - step: &go-test
        name: Test go/auth
        image: golang:1.22
        condition:
          changesets:
            includePaths: ["go/auth/**", "bitbucket-pipelines.yml"]
        script:
          - *install-make
          - cd go/auth
          - make setup
          - make lint
          - make test

    - step: &go-publish-dev
        name: Publish go/auth (dev)
        image: gcr.io/google.com/cloudsdktool/google-cloud-cli:alpine
        oidc: true
        condition:
          changesets:
            includePaths: ["go/auth/**"]
        script:
          - *gcp-auth
          - *go-publish-setup
          - VERSION="v$(cat VERSION)-dev.${BITBUCKET_BUILD_NUMBER}" make publish

    - step: &go-publish-tag
        name: Publish go/auth
        image: gcr.io/google.com/cloudsdktool/google-cloud-cli:alpine
        oidc: true
        script:
          - *reject-suffixed-tag
          - *gcp-auth
          - *go-publish-setup
          - VERSION="v${BITBUCKET_TAG#go-auth@}" make publish

pipelines:
  custom:
    # Ejecutar todos los tests manualmente (sin publicar)
    test-all:
      - step: *python-test
      - step: *typescript-test
      - step: *go-test

    # Publicar dev de todos los paquetes ignorando changesets
    publish-all-dev:
      - step:
          <<: *python-publish-dev
          condition: ~
      - step:
          <<: *typescript-publish-dev
          condition: ~
      - step:
          <<: *go-publish-dev
          condition: ~

    # tag-multi-prod: N llamadas a `release.sh tag`, no un bulk ciego. Recibe
    # una lista explícita de librerías (variable PROJECTS, el humano la llena
    # al disparar el pipeline) y llama `./scripts/release.sh tag <lib>` una
    # vez por cada una — reusa tal cual todas las validaciones de `cmd_tag`
    # (require_trunk, require_clean, hotfixes pendientes, versión leída del
    # manifiesto ya bumpeado+revisado por PR). No bypasea ni duplica esa
    # lógica — solo la orquesta. Preserva la independencia de despliegue
    # entre librerías (ADR-0007): cada una se valida y tagea por separado,
    # el humano decide explícitamente cuáles N están listas AHORA. El push
    # de cada tag dispara su propio *-publish-tag ya existente arriba.
    tag-multi-prod:
      - variables:
          - name: PROJECTS
            default: ""
            description: >-
              Librerías listas para publicar, separadas por coma (ej:
              python-auth,go-auth). Cada una debe tener su versión YA
              bumpeada + PR revisado en el manifiesto — este pipeline NO
              bumpea nada, solo tagea lo que ya está listo.
      - step:
          name: Tag N librerías a producción
          trigger: manual    # gate de aprobación humana OBLIGATORIO
          script:
            - git fetch --unshallow || true
            - |
              if [[ -z "$PROJECTS" ]]; then
                echo "ERROR: variable PROJECTS vacía — especifica al menos una librería"
                exit 1
              fi
              IFS=',' read -ra PROJS <<< "$PROJECTS"
              for p in "${PROJS[@]}"; do
                p=$(echo "$p" | xargs)
                [[ -z "$p" ]] && continue
                echo "=== Tagging $p ==="
                ./scripts/release.sh tag "$p"
              done

  # Tags por paquete → publica la versión correspondiente (esquema <proyecto>@<version>,
  # el mismo que genera `release.sh tag`)
  tags:
    'python-auth@*':
      - step: *python-publish-tag
    'typescript-auth@*':
      - step: *typescript-publish-tag
    'go-auth@*':
      - step: *go-publish-tag

  # PRs → solo tests, sin publicar
  pull-requests:
    "**":
      - step: *python-test
      - step: *typescript-test
      - step: *go-test

  # Branches dev y main
  branches:
    # dev → test + publish por stack (interleaved: cada lib es independiente)
    dev:
      - step: *python-test
      - step: *python-publish-dev
      - step: *typescript-test
      - step: *typescript-publish-dev
      - step: *go-test
      - step: *go-publish-dev

    # main → solo quality gate; librerías se publican únicamente via tag explícito
    main:
      - step: *python-test
      - step: *typescript-test
      - step: *go-test
