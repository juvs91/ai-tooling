llama-build () {
  local repo="${1:-$PWD}"              # ← usa la carpeta donde estés
  (
    set -e
    mkdir -p "$repo/build"
    cd "$repo/build"
    cmake .. -DCMAKE_BUILD_TYPE=Release -DLLAMA_METAL=ON
    cmake --build . --parallel "$(sysctl -n hw.logicalcpu)"
  ) || { echo "❌ Falló la compilación"; return 1; }

  echo "✅ Binarios en $repo/build/bin/"
}
eval "$(pyenv virtualenv-init -)"

# Added by Antigravity
export PATH="/Users/jeguzman/.antigravity/antigravity/bin:$PATH"

# opencode
export PATH=/Users/jeguzman/.opencode/bin:$PATH
# ---- OpenCode profile switcher ----
opencode-profile() {
  local BASE="$HOME/.config"
  local ACTIVE="$BASE/opencode"
  local MINE="$BASE/opencode.mine"
  local AGENTIC="$BASE/opencode.agentic"

  case "$1" in
    mine)
      [[ -d "$MINE" ]] || { echo "❌ No existe $MINE"; return 1 }
      ln -snf "$MINE" "$ACTIVE"
      echo "✅ OpenCode activo: MINE"
      ;;
    agentic)
      [[ -d "$AGENTIC" ]] || { echo "❌ No existe $AGENTIC"; return 1 }
      ln -snf "$AGENTIC" "$ACTIVE"
      echo "✅ OpenCode activo: AGENTIC"
      ;;
    status|"")
      if [[ -L "$ACTIVE" ]]; then
        echo "🔎 OpenCode activo → $(readlink "$ACTIVE")"
      else
        echo "⚠️  $ACTIVE no es un symlink"
        ls -ld "$ACTIVE"
      fi
      ;;
    *)
      echo "Uso: opencode-profile [mine|agentic|status]"
      return 1
      ;;
  esac
}

# Autocompletado simple
compdef '_values "profiles" mine agentic status' opencode-profile
# ---- end OpenCode profile switcher ----

export PATH="$HOME/bin:$PATH"

# bun completions
[ -s "/Users/jeguzman/.bun/_bun" ] && source "/Users/jeguzman/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
